# Copy to .env.local for local dev. In production, set these in the Vercel
# dashboard (Project → Settings → Environment Variables). Never commit real values.

# --- Database ---
# Local dev: local Docker Postgres (see docker-compose.yml).
# Production (Vercel): use the Supabase TRANSACTION POOLER string (Supabase →
# Connect → Transaction pooler) — it's IPv4 and works on serverless.
DATABASE_URL=postgres://nfda:nfda@localhost:5434/nfda

# --- AI post generation ---
# Uses whichever is set (OpenAI preferred, then Anthropic); without either it
# falls back to a safe stub so the app still runs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=

# --- Facebook / Meta ---
# The callback URL is derived from the request origin automatically, so you do
# NOT set a redirect URL here — but you MUST add these to the Meta app's
# "Valid OAuth Redirect URIs":  https://<your-domain>/api/facebook/callback
META_APP_ID=
META_APP_SECRET=
# Business apps use a Login Configuration ID instead of raw scopes (optional).
META_CONFIG_ID=

# --- Safety ---
# When true, posting is SIMULATED and never hits Facebook. Keep true until go-live.
FACEBOOK_DRY_RUN=true

# --- Cron (production) ---
# Set a random string; Vercel Cron sends it as a Bearer token to /api/cron/scrape.
CRON_SECRET=
