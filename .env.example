# Copy to .env.local and fill in. Never commit real secrets.

# Local Docker Postgres (see docker-compose.yml). For production, paste the
# Supabase connection string here instead — the schema is identical.
DATABASE_URL=postgres://nfda:nfda@localhost:5434/nfda

# AI post generation. The generator uses whichever is set (OpenAI preferred,
# then Anthropic); without either it falls back to a safe stub so the app still
# runs. OpenAI: platform.openai.com/api-keys. Anthropic: console.anthropic.com.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=

# Test safety: when true, "posting" is simulated and never hits Facebook.
FACEBOOK_DRY_RUN=true

# Facebook / Meta Graph API (Week 2, Facebook step). Create an app at
# developers.facebook.com → App ID + App Secret.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/facebook/callback
