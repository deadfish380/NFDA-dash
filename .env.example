# Copy to .env.local for local dev. In production, set these in the Vercel
# dashboard (Project → Settings → Environment Variables). Never commit real values.

# --- Database ---
# Local dev: local Docker Postgres (see docker-compose.yml).
# Production (Vercel): use the Supabase TRANSACTION POOLER string (Supabase →
# Connect → Transaction pooler) — it's IPv4 and works on serverless.
DATABASE_URL=postgres://nfda:nfda@localhost:5434/nfda

# --- AI post generation ---
# Uses whichever is set (OpenAI preferred, then Anthropic); without either it
# falls back to a safe stub so the app still runs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=

# --- AI post images ---
# Each post gets an AI-generated image (OpenAI image model). Set POST_IMAGES=false
# to skip paid image calls (e.g. while testing text). Needs OPENAI_API_KEY.
# gpt-image-1 is the default (returns JPEG bytes). If your key only has DALL·E,
# set OPENAI_IMAGE_MODEL=dall-e-3 and OPENAI_IMAGE_SIZE=1792x1024.
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
POST_IMAGES=true

# Public origin of the deployed app — used to build ABSOLUTE image URLs that
# Facebook can fetch (e.g. https://your-app.vercel.app/api/post-image/<id>).
# On Vercel this is auto-derived from VERCEL_PROJECT_PRODUCTION_URL; set it
# explicitly if you use a custom domain. Leave blank locally.
APP_BASE_URL=

# --- Image storage (Supabase Storage) — OPTIONAL ---
# Not required: without it, images are served by the app's own /api/post-image
# route (absolute URL via APP_BASE_URL above), which Facebook can fetch in prod.
# Configure this only if you'd rather host images on Supabase's CDN.
# Where generated images are hosted so Facebook can load them. Create a PUBLIC
# bucket named below. Without these, images fall back to inline data URLs — fine
# for the dashboard preview, but Facebook can't attach a data URL, so set these
# before go-live. SUPABASE_URL can reuse your project URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=post-images

# --- Facebook / Meta ---
# The callback URL is derived from the request origin automatically, so you do
# NOT set a redirect URL here — but you MUST add these to the Meta app's
# "Valid OAuth Redirect URIs":  https://<your-domain>/api/facebook/callback
META_APP_ID=
META_APP_SECRET=
# Business apps use a Login Configuration ID instead of raw scopes (optional).
META_CONFIG_ID=

# --- Safety ---
# When true, posting is SIMULATED and never hits Facebook. Keep true until go-live.
FACEBOOK_DRY_RUN=true

# Encrypts Facebook page tokens at rest (AES-256-GCM). Any random string. If unset,
# tokens are stored as-is (dev). Set a strong value in production.
APP_ENCRYPTION_KEY=

# --- Cron (production) ---
# Random string; Vercel Cron sends it as a Bearer token. Protects ALL cron routes:
#   /api/cron/scrape (daily), /api/cron/generate (daily), /api/cron/publish (hourly).
# NOTE: Vercel Hobby runs crons once/day only — for hourly publishing use Vercel Pro
# or an external scheduler (e.g. cron-job.org) hitting /api/cron/publish.
CRON_SECRET=
